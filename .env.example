# Optional: set a key to protect the proxy endpoints (must match BE TAPTAP_PROXY_KEY)
API_KEY=your-secret-key-here

# Railway auto-provides PORT, no need to set manually
# PORT=3000

# GET /api/full/:appId returns { appInfo, detailRaw, reviews }.
# `detailRaw` is the full TapTap app/v4/detail JSON (information[], tags, …) for AI analysis context on the backend.
